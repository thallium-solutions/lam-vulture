# Public API no other test calls, through `inject`: server, request and
# reply decorators (`decorate`, `decorateRequest`, `decorateReply`,
# `decorateResponse`, `dec`, `hasDec`, `hasDecorator`); custom content-type
# parsers (parameters stripped, overriding a built-in); `options` and `all`
# routes; the `HttpError` factories (`badRequest` ... `serviceUnavailable`),
# `toString` and `withRetryAfter`; `Problem.withIssues`; request ids
# (`setId`/`id`) set by a hook; `startTime`; `ips` and `realScheme` with and
# without `trustProxy`; `push` on HTTP/1 (dropped); clearing the
# payload-too-large and schema-issue handlers; non-ASCII path parameters,
# queries and JSON bodies with byte-exact `Content-Length`.
#
# expect: server decorators: pg true false None
# expect: request decorators: fr pg true false
# expect: reply decorators: html-helper json-helper true false
# expect: csv parser: [a b c] 3
# expect: text parser override: TEXT:hello
# expect: options route: 204 GET, POST
# expect: all route: GET:any POST:any DELETE:any PATCH:any
# expect: http errors: 400 401 403 500 502 503
# expect: http error body: Bad Gateway upstream down
# expect: toString: HttpError(409): duplicate
# expect: retry after: 503 30
# expect: problem issues: 2 price/minimum name/required
# expect: request id: req-7 req-7
# expect: start time: true
# expect: ips: [inject] then [203.0.113.5 inject]
# expect: scheme: http then https
# expect: push on http/1: 200 pushed
# expect: payload too large: 413 custom 413 then 413 413 payload too large
# expect: schema issues: 422 custom 422 then 400
# expect: unicode param: été 🦅 query: Zoë
# expect: unicode json: {"echo":"Grüße 東京 🦅"} length=bytes
# expect: ok

from @lam/vulture import Server, Request, Response, InjectResponse, HttpError, Problem, SchemaIssue, RouteOptions
from lamerrors import Result
from lamjson import Json

func show(value: any) -> str {
    return "None" if value == None else str(value)
}

func decorated(req: Request, res: Response) {
    res.text(f"{show(req.dec('locale'))} {show(req.dec('db'))} {req.hasDec('locale')} {req.hasDec('missing')}")
}

func replyDecorated(req: Request, res: Response) {
    res.text(f"{show(res.dec('html'))} {show(res.dec('json'))} {res.hasDec('html')} {res.hasDec('missing')}")
}

func parseCsv(req: Request) -> any {
    return req.body.split(",")
}

func parseText(req: Request) -> any {
    return "TEXT:" + req.body
}

func parsedHandler(req: Request, res: Response) {
    parsed: any = req.parsedBody().unwrap()
    if isinstance(parsed, list) {
        items: list[str] = parsed
        res.text(f"[{' '.join(items)}] {len(items)}")
        return
    }
    res.text(str(parsed))
}

func optionsHandler(req: Request, res: Response) {
    res.header("Allow", "GET, POST")
    res.code(204).send("")
}

func anyMethod(req: Request, res: Response) {
    res.text(f"{req.method}:any")
}

func failing(req: Request, res: Response) {
    kind: str = req.params[":kind"]
    if kind == "400" {
        throw HttpError.badRequest()
    } elif kind == "401" {
        throw HttpError.unauthorized()
    } elif kind == "403" {
        throw HttpError.forbidden()
    } elif kind == "500" {
        throw HttpError.internal()
    } elif kind == "502" {
        throw HttpError.badGateway("upstream down")
    } elif kind == "503" {
        throw HttpError.serviceUnavailable().withRetryAfter(30)
    }
    res.text("no error")
}

func assignId(req: Request, res: Response) {
    if req.header("X-Request-Id") != "" {
        req.setId(req.header("X-Request-Id"))
    }
}

func idHandler(req: Request, res: Response) {
    res.header("X-Seen-Id", req.id())
    res.text(f"{req.id()} start={req.startTime() > 0}")
}

func ipsHandler(req: Request, res: Response) {
    res.text(f"[{' '.join(req.ips())}] {req.realScheme()}")
}

func pushHandler(req: Request, res: Response) {
    res.push("/static/app.js", "application/javascript").text("pushed")
}

func uploadHandler(req: Request, res: Response) {
    res.text(f"stored {len(req.body)}")
}

func customTooLarge(req: Request, res: Response) {
    res.code(413).send("custom 413")
}

func customIssues(part: str, issues: list[SchemaIssue], req: Request, res: Response) {
    res.code(422).send("custom 422")
}

func validated(req: Request, res: Response) {
    res.text("valid")
}

func greet(req: Request, res: Response) {
    res.text(f"{req.params[':name']} query: {req.query['who']}")
}

func echoJson(req: Request, res: Response) -> json {
    body: json = Json.decode(req.body).unwrap()
    return {"echo": body.text}
}

func main() {
    srv: Server = Server()
    srv.decorate("db", "pg")
    srv.decorateRequest("locale", "fr")
    srv.decorateReply("html", "html-helper")
    srv.decorateResponse("json", "json-helper")
    print(f"server decorators: {srv.dec('db')} {srv.hasDecorator('db')} {srv.hasDecorator('locale')} {show(srv.dec('missing'))}")
    srv.get("/decorated", decorated)
    srv.get("/reply-decorated", replyDecorated)
    srv.addContentTypeParser("Application/X-CSV", parseCsv)
    srv.addContentTypeParser("text/plain", parseText)
    srv.post("/parsed", parsedHandler)
    srv.options("/things", optionsHandler)
    srv.all("/anything", anyMethod)
    srv.get("/fail/:kind", failing)
    srv.preHandler(assignId)
    srv.get("/id", idHandler)
    srv.get("/ips", ipsHandler)
    srv.get("/push", pushHandler)
    srv.post("/upload", uploadHandler, RouteOptions(8))
    bodySchema: json = {"type": "object", "required": ["name"]}
    srv.post("/validated", validated, RouteOptions().withSchema({"body": bodySchema}))
    srv.get("/hello/:name", greet)
    srv.post("/echo", echoJson)

    print(f"request decorators: {srv.inject('GET', '/decorated').body}")
    print(f"reply decorators: {srv.inject('GET', '/reply-decorated').body}")
    print(f"csv parser: {srv.inject('POST', '/parsed', 'a,b,c', {'Content-Type': 'application/x-csv; charset=utf-8'}).body}")
    print(f"text parser override: {srv.inject('POST', '/parsed', 'hello', {'Content-Type': 'text/plain'}).body}")
    opts: InjectResponse = srv.inject("OPTIONS", "/things")
    print(f"options route: {opts.status} {opts.header('Allow')}")
    methods: list[str] = [srv.inject(m, "/anything").body for m in ["GET", "POST", "DELETE", "PATCH"]]
    print(f"all route: {' '.join(methods)}")

    statuses: list[int] = [srv.inject("GET", f"/fail/{k}").status for k in ["400", "401", "403", "500", "502", "503"]]
    print(f"http errors: {' '.join([str(s) for s in statuses])}")
    gateway: json = Json.decode(srv.inject("GET", "/fail/502").body).unwrap()
    errorText: str = gateway.error
    messageText: str = gateway.message
    print(f"http error body: {errorText} {messageText}")
    print(f"toString: {HttpError(409, 'duplicate').toString()}")
    unavailable: InjectResponse = srv.inject("GET", "/fail/503")
    print(f"retry after: {unavailable.status} {unavailable.header('Retry-After')}")
    problem: Problem = Problem(422).withIssues([SchemaIssue("price", "minimum", "must be >= 0"), SchemaIssue("name", "required", "is required")])
    fields: list[str] = []
    for issue in problem.errors {
        field: str = issue.field
        keyword: str = issue.keyword
        fields.append(f"{field}/{keyword}")
    }
    print(f"problem issues: {len(problem.errors)} {' '.join(fields)}")

    withId: InjectResponse = srv.inject("GET", "/id", "", {"X-Request-Id": "req-7"})
    print(f"request id: {withId.body.split(' ')[0]} {withId.header('X-Seen-Id')}")
    print(f"start time: {withId.body.endsWith('start=true')}")

    direct: str = srv.inject("GET", "/ips", "", {"X-Forwarded-For": "203.0.113.5", "X-Forwarded-Proto": "https"}).body
    srv.trustProxy(["X-Forwarded-For"])
    proxied: str = srv.inject("GET", "/ips", "", {"X-Forwarded-For": "203.0.113.5", "X-Forwarded-Proto": "https"}).body
    print(f"ips: {direct.split(' ')[0]} then {proxied.split('] ')[0]}]")
    print(f"scheme: {direct.split(' ')[-1]} then {proxied.split(' ')[-1]}")
    pushed: InjectResponse = srv.inject("GET", "/push")
    print(f"push on http/1: {pushed.status} {pushed.body}")

    srv.setPayloadTooLargeHandler(customTooLarge)
    custom: InjectResponse = srv.inject("POST", "/upload", "0123456789")
    srv.clearPayloadTooLargeHandler()
    restored: InjectResponse = srv.inject("POST", "/upload", "0123456789")
    print(f"payload too large: {custom.status} {custom.body} then {restored.status} {restored.body}")

    srv.setSchemaIssueHandler(customIssues)
    issueCustom: InjectResponse = srv.inject("POST", "/validated", "{}", {"Content-Type": "application/json"})
    srv.clearSchemaIssueHandler()
    issueDefault: InjectResponse = srv.inject("POST", "/validated", "{}", {"Content-Type": "application/json"})
    print(f"schema issues: {issueCustom.status} {issueCustom.body} then {issueDefault.status}")

    print(f"unicode param: {srv.inject('GET', '/hello/%C3%A9t%C3%A9%20%F0%9F%A6%85?who=Zo%C3%AB').body}")
    echoed: InjectResponse = srv.inject("POST", "/echo", "{\"text\": \"Grüße 東京 🦅\"}", {"Content-Type": "application/json"})
    lengthOk: bool = echoed.header("Content-Length") == "" or echoed.header("Content-Length") == str(len(bytes(echoed.body)))
    print(f"unicode json: {echoed.body} length={'bytes' if lengthOk else echoed.header('Content-Length')}")
    print("ok")
}
