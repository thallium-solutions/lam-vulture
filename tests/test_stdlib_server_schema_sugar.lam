# expect: json-valid=200:called
# expect: json-invalid=400
# expect: none-schema=200:called
# expect: yaml-valid=200:called
# expect: yaml-invalid=400
# expect: xml-valid=200:called
# expect: xml-invalid=400
# expect: openapi-yaml=true
# expect: openapi-xml=true
# expect: invalid-schema-rejected=true

from @lam/vulture import InjectResponse, Request, Response, Server

go! {
    import "strings"
}

func called(req: Request, res: Response) {
    res.text("called")
}

func main() {
    server: Server = Server()
    jsonSchema: json = {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 2}},
    }
    yamlSchema: str = "type: object\nrequired: [name]\nproperties:\n  name:\n    type: string\n    minLength: 2\n"
    xsdSchema: str = "<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\"><xs:element name=\"name\" type=\"xs:string\"/></xs:schema>"

    server.post("/json", called, jsonSchema, "json")
    server.post("/none", called)
    server.post("/yaml", called, yamlSchema, "yaml")
    server.post("/xml", called, xsdSchema, "xml")
    invalidSchemaRejected: bool = false
    invalidSchemaText: str = "{not-" + "json}"
    try {
        server.post("/invalid-schema", called, invalidSchemaText, "json")
    } catch err {
        invalidSchemaRejected = true
    }

    jsonValid: InjectResponse = server.inject("POST", "/json", '{"name":"Ada"}')
    jsonInvalid: InjectResponse = server.inject("POST", "/json", '{"name":"A"}')
    noneSchema: InjectResponse = server.inject("POST", "/none", "anything")
    yamlValid: InjectResponse = server.inject("POST", "/yaml", "name: Ada\n")
    yamlInvalid: InjectResponse = server.inject("POST", "/yaml", "name: A\n")
    xmlValid: InjectResponse = server.inject("POST", "/xml", "<name>Ada</name>")
    xmlInvalid: InjectResponse = server.inject("POST", "/xml", "<other>Ada</other>")

    jsonValidStatus: any = jsonValid.status
    jsonValidBody: any = jsonValid.body
    jsonInvalidStatus: any = jsonInvalid.status
    noneStatus: any = noneSchema.status
    noneBody: any = noneSchema.body
    yamlValidStatus: any = yamlValid.status
    yamlValidBody: any = yamlValid.body
    yamlInvalidStatus: any = yamlInvalid.status
    xmlValidStatus: any = xmlValid.status
    xmlValidBody: any = xmlValid.body
    xmlInvalidStatus: any = xmlInvalid.status
    print(f"json-valid={jsonValidStatus}:{jsonValidBody}")
    print(f"json-invalid={jsonInvalidStatus}")
    print(f"none-schema={noneStatus}:{noneBody}")
    print(f"yaml-valid={yamlValidStatus}:{yamlValidBody}")
    print(f"yaml-invalid={yamlInvalidStatus}")
    print(f"xml-valid={xmlValidStatus}:{xmlValidBody}")
    print(f"xml-invalid={xmlInvalidStatus}")

    spec: str = server.openapi()
    hasYaml: bool = false
    hasXml: bool = false
    go! {
        hasYaml = strings.Contains(spec, `"application/yaml"`)
        hasXml = strings.Contains(spec, `"application/xml"`)
    }
    print(f"openapi-yaml={hasYaml}")
    print(f"openapi-xml={hasXml}")
    print(f"invalid-schema-rejected={invalidSchemaRejected}")
}
