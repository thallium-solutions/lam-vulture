# Integration test: ``req.bodyReader()`` + per-route ``streamBody``
# opt-in. Covers four scenarios:
#
#   1. **Buffered route falls back to a strings.Reader** — the
#      handler reads the body via ``bodyReader()`` even though the
#      route did not opt into streaming. ``req.body`` is still
#      populated; the reader just wraps it.
#   2. **Streamed route pulls chunks directly** — a route with
#      ``streamBody: true`` sees ``req.body == ""`` and a reader
#      that yields the body in 16-byte chunks. The handler counts
#      chunks to prove streaming is active.
#   3. **Streamed route + ``copyTo`` writes the upload straight to
#      disk** — we POST a small payload, let the handler dump it
#      to a temp file, and verify the file contents match.
#   4. **Streamed route respects per-route ``bodyLimit``** — with a
#      low cap and an oversized body, the reader surfaces the
#      413 ``HttpError`` via the server's default error handler.
#
# expect: t1-buffered-read: hello-buffered-body
# expect: t1-body-populated: true
# expect: t2-chunks: 3
# expect: t2-bytes: 40
# expect: t2-body-empty: true
# expect: t3-disk-contents: ABCDEFGHIJ
# expect: t4-status: 413
# expect: t5-copy-error: true

from @lam/vulture import Server, Request, Response, RequestBodyReader, RouteOptions
from lamerrors import Result
from lamos import Os

go! {
    import (
        "bytes"
        "encoding/json"
        "io"
        "net/http"
        "time"
    )
}

func resultInt(result: Result[int]) -> int {
    go! {
        return result.Value.(int)
    }
}

func bufferedHandler(req: Request, res: Response) {
    r: RequestBodyReader = req.bodyReader()
    joined: str = ""
    while true {
        chunk: str = str(r.read(1024).unwrap())
        if chunk == "" {
            break
        }
        joined = joined + chunk
    }
    # Buffered routes keep ``req.body`` around so the reader is a
    # convenience, not a necessity.
    res.text(joined)
}

func streamedHandler(req: Request, res: Response) {
    r: RequestBodyReader = req.bodyReader()
    chunkCount: int = 0
    total: int = 0
    while true {
        chunk: str = str(r.read(16).unwrap())
        if chunk == "" {
            break
        }
        chunkCount = chunkCount + 1
        total = total + len(chunk)
    }
    _ = r.close().unwrap()
    res.json( {
        "chunks": chunkCount,
        "bytes": total,
        "bodyEmpty": len(req.body) == 0,
    })
}

func copyHandler(req: Request, res: Response) {
    r: RequestBodyReader = req.bodyReader()
    dst: str = req.queryGet("dst", "/tmp/lam-upload-test.bin")
    n: int = resultInt(r.copyTo(dst))
    _ = r.close().unwrap()
    res.json( {"wrote": n, "path": dst})
}

func copyFailureHandler(req: Request, res: Response) {
    reader: RequestBodyReader = req.bodyReader()
    copied: Result[int] = reader.copyTo("/definitely/missing/lam-vulture/upload.bin")
    res.text(str(not copied.ok()))
}

func limitedHandler(req: Request, res: Response) {
    r: RequestBodyReader = req.bodyReader()
    # Drain fully — this should hit 413 when the payload is
    # bigger than the route's body-limit cap.
    drained: Result[str] = r.readAll()
    if not drained.ok() {
        go! {
            panic(drained.Error)
        }
    }
    _ = r.close().unwrap()
    res.text("should-not-reach")
}

func httpPost(url: str, body: str) -> dict[str, any] {
    out: dict[str, any] = {"status": 0, "body": ""}
    go! {
        client := &http.Client{Timeout: 2 * time.Second}
        resp, err := client.Post(url, "application/octet-stream",
            bytes.NewBufferString(body))
        if err != nil {
            out["status"] = 0
            out["body"] = err.Error()
            return out
        }
        defer resp.Body.Close()
        b, _ := io.ReadAll(resp.Body)
        out["status"] = resp.StatusCode
        out["body"] = string(b)
    }
    return out
}

func main() {
    srv: Server = Server()

    srv.post("/buffered", bufferedHandler)
    srv.post("/streamed", streamedHandler, RouteOptions(0, 0, true))
    srv.post("/copy", copyHandler, RouteOptions(0, 0, true))
    srv.post("/limited", limitedHandler, RouteOptions(8, 0, true))
    srv.post("/copy-failure", copyFailureHandler, RouteOptions(0, 0, true))

    _ = srv.listenBackground(0).unwrap()
    addr: str = srv.boundAddr

    # ── Test 1: buffered fallback — the reader just wraps body.
    r1: dict[str, any] = httpPost("http://" + addr + "/buffered",
    "hello-buffered-body")
    b1: any = r1["body"]
    print("t1-buffered-read: " + str(b1))
    # Confirm req.body was still populated on a buffered route.
    # We can't observe it from outside, but since the handler
    # echoed the concatenated chunk output and that matches the
    # body, we know the wrapping path worked.
    s1: any = r1["status"]
    print("t1-body-populated: " + str(s1 == 200))

    # ── Test 2: streamed route — expect 3 chunks of 16 bytes
    # (2 × 16 + 1 × 8 = 40 total) and req.body empty.
    payload: str = ""
    i: int = 0
    while i < 40 {
        payload = payload + "X"
        i = i + 1
    }
    r2: dict[str, any] = httpPost("http://" + addr + "/streamed", payload)
    b2: any = r2["body"]
    chunks2: int = 0
    bytes2: int = 0
    bodyEmpty2: bool = false
    go! {
        if bs, ok := b2.(string); ok {
            var parsed map[string]interface{}
            if err := json.Unmarshal([]byte(bs), &parsed); err == nil {
                if n, ok := parsed["chunks"].(float64); ok {
                    chunks2 = int(n)
                }
                if n, ok := parsed["bytes"].(float64); ok {
                    bytes2 = int(n)
                }
                if be, ok := parsed["bodyEmpty"].(bool); ok {
                    bodyEmpty2 = be
                }
            }
        }
    }
    print(f"t2-chunks: {chunks2}")
    print(f"t2-bytes: {bytes2}")
    print(f"t2-body-empty: {bodyEmpty2}")

    # ── Test 3: streamed route copies bytes to disk.
    tmpPath: str = "/tmp/lam-stream-body-test.bin"
    r3: dict[str, any] = httpPost(
    "http://" + addr + "/copy?dst=" + tmpPath,
    "ABCDEFGHIJ",
    )
    s3: any = r3["status"]
    diskContents: str = str(Os.readFile(tmpPath).value)
    print(f"t3-disk-contents: {diskContents}")
    if s3 == 200 {
        Os.remove(tmpPath)
    }

    # ── Test 4: streamed route + per-route body-limit trips 413.
    bigPayload: str = ""
    j: int = 0
    while j < 32 {
        bigPayload = bigPayload + "Y"
        j = j + 1
    }
    r4: dict[str, any] = httpPost("http://" + addr + "/limited", bigPayload)
    s4: any = r4["status"]
    print("t4-status: " + str(s4))

    r5: dict[str, any] = httpPost("http://" + addr + "/copy-failure", "payload")
    print("t5-copy-error: " + str(r5["body"]))

    srv.close()
}
